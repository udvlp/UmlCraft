<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-umlcraft">
    <comment>UmlCraft project</comment>
    <comment xml:lang="de">UmlCraft-Projekt</comment>
    <comment xml:lang="fr">Projet UmlCraft</comment>
    <sub-class-of type="application/json"/>
    <icon name="com.umlcraft.app"/>
    <glob pattern="*.ucraft"/>
  </mime-type>
  <mime-type type="application/x-astah">
    <comment>Astah project</comment>
    <comment xml:lang="de">Astah-Projekt</comment>
    <comment xml:lang="fr">Projet Astah</comment>
    <glob pattern="*.asta"/>
  </mime-type>
  <mime-type type="application/x-structorizer">
    <comment>Structorizer structogram</comment>
    <comment xml:lang="de">Structorizer-Struktogramm</comment>
    <comment xml:lang="fr">Structogramme Structorizer</comment>
    <sub-class-of type="application/xml"/>
    <glob pattern="*.nsd"/>
  </mime-type>
</mime-info>
