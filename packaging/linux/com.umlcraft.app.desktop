[Desktop Entry]
Type=Application
Name=UmlCraft
GenericName=UML Modeling Tool
GenericName[de]=UML-Modellierungswerkzeug
GenericName[fr]=Outil de modélisation UML
Comment=Draw UML diagrams, open Astah projects and import source code
Comment[de]=UML-Diagramme zeichnen, Astah-Projekte öffnen und Quellcode importieren
Comment[fr]=Dessiner des diagrammes UML, ouvrir des projets Astah et importer du code source
Exec=umlcraft %f
Icon=com.umlcraft.app
Terminal=false
Categories=Development;
Keywords=UML;diagram;class;sequence;Astah;
MimeType=application/x-umlcraft;application/x-astah;application/x-structorizer;
StartupWMClass=com.umlcraft.app
